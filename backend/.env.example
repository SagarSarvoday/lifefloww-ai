# Ollama Cloud Configuration
# Retrieve your API key from https://ollama.com (Sign in -> Developer/Settings -> API Keys)
OLLAMA_API_KEY=your_ollama_cloud_api_key

# Model name: Ollama Cloud models commonly use designated cloud names
# e.g., gpt-oss:20b, gemma4:31b, nemotron-3-nano:30b
OLLAMA_MODEL=gpt-oss:20b

# Ollama Cloud Host endpoint (defaults to https://ollama.com)
OLLAMA_HOST=https://ollama.com

# Request timeout in seconds
OLLAMA_TIMEOUT=30.0

# Application Environment (development, production, testing)
APP_ENV=development

# Application Default Timezone (IANA Time Zone string)
APP_TIMEZONE=Asia/Kolkata

# Testing flags (set to true only when running live cloud tests with a valid key)
RUN_OLLAMA_INTEGRATION_TESTS=false

# ---------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# ---------------------------------------------------------------------------
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Notes:
# 1. For local development, prefer the Supabase Session Pooler (port 5432) for IPv4 compatibility and prepared statement support.
# 2. If your database password contains special characters (e.g., @, :, #, %), make sure they are URL-encoded.
# 3. SQLAlchemy will automatically use the async psycopg driver (postgresql+psycopg://).
DATABASE_URL=postgresql://postgres.yourprojectref:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
